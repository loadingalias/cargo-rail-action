{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/loadingalias/cargo-rail-action/main/schemas/cache-status-v1.schema.json",
  "title": "Cargo-Rail Action cache status v1",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "cargo_rail",
    "provider",
    "mode",
    "max_bytes",
    "root_portability",
    "remote_verification"
  ],
  "properties": {
    "schema_version": { "const": 1 },
    "cargo_rail": { "type": "string", "pattern": "^0\\.26\\.(0|[1-9][0-9]*)$" },
    "provider": { "enum": ["aws-s3", "azure-blob", "cloudflare-r2", "s3-compatible"] },
    "mode": { "enum": ["read", "read-write"] },
    "max_bytes": { "type": "integer", "minimum": 1 },
    "root_portability": { "enum": ["physical", "remap"] },
    "remote_verification": { "enum": ["not_requested", "verified"] }
  }
}
